{
  "name": "revive-hogar-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Revive Hogar",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.2",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^7.0.11",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.0"
  }
}
